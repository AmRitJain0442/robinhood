{
  "name": "@amritjain0442/robinhood",
  "version": "0.0.1",
  "private": true,
  "description": "A local coding terminal with durable sessions and explicit model routing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "robinhood": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "demo": "npm run build && node dist/src/cli.js demo",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "eventsource-parser": "4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "typescript": "6.0.3"
  }
}
